# Public (safe to expose to browser)
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (Pollinations AI)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai/v1
POLLINATIONS_MODEL=chirag-gamer/gpt-oss-120b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://gen.pollinations.ai/v1
DEEPSEEK_MODEL=chirag-gamer/gpt-oss-120b
OCR_ASSISTANT_MODEL=chirag-gamer/gpt-oss-120b
OCR_VISION_MODEL=YoannDev90/muse-glimmer-30b:free

# openFDA (optional, improves verification + label details)
OPENFDA_API_KEY=

# Google Serper (optional, web verification before AI analysis)
SERPER_API_KEY=

# Telegram Bot (CEO admin notifications & control hub)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email delivery (choose one: Resend API or Gmail/SMTP)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ElevenLabs Text-to-Speech (optional, voice reader feature)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Public site URL (used for auth redirects and links)
NEXT_PUBLIC_SITE_URL=

